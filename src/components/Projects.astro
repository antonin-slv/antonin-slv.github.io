---
import type { Props } from "../config";
import ProjectCardsSection from "./ProjectCardsSection.astro";
const { siteConfig } = Astro.props as Props;

const projects = siteConfig.projects || [];
const title = siteConfig?.language === "fr" ? "Mes Autres Projets" : "My other Projects";
---

<ProjectCardsSection siteConfig={siteConfig} title={title} items={projects} />