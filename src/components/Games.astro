---
import type { Props } from "../config";
import ProjectCardsSection from "./ProjectCardsSection.astro";
const { siteConfig } = Astro.props as Props;

const games = siteConfig.games || [];
const title = siteConfig?.language === "fr" ? "Mes Jeux" : "My Games";
---

<ProjectCardsSection
  siteConfig={siteConfig}
  title={title}
  items={games}
  allowCardWithoutSlug={true}
/>