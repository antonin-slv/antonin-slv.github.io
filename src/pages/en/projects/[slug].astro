---
import { enSiteConfig } from "../../../config_en";
import ProjectDetailPage from "../../../components/ProjectDetailPage.astro";

export function getStaticPaths() {
  var proj = enSiteConfig.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));

  var games = enSiteConfig.games ? enSiteConfig.games.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  })) : [];

  return [...proj, ...games];
}

const { project } = Astro.props;
---

<ProjectDetailPage
  project={project}
  siteConfig={enSiteConfig}
  titleSuffix="Antonin Sylvestre Portfolio"
  backHref="/en/#projects"
  backLabel="Return"
  playLabel="View Project / Play"
  contributionsTitle="My Contributions"
  galleryTitle="Gallery"
/>