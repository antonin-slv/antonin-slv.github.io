---
import { frSiteConfig } from "../../../config_fr";
import ProjectDetailPage from "../../../components/ProjectDetailPage.astro";

export function getStaticPaths() {
  var projectPaths = frSiteConfig.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
  var gamesPaths = frSiteConfig.games ? frSiteConfig.games.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  })) : [];

  return [...projectPaths, ...gamesPaths];

}

const { project } = Astro.props;
---

<ProjectDetailPage
  project={project}
  siteConfig={frSiteConfig}
  titleSuffix="Portfolio Antonin Sylvestre"
  backHref="/fr/#projects"
  backLabel="Retour"
  playLabel="Voir le projet / Jouer"
  contributionsTitle="Mes Contributions"
  galleryTitle="Galerie"
/>